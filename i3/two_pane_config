set $mod Mod4
set $smod Shift

set $wm_setting_gap_width 15
set $wm_setting_gap_height 15
set $wm_setting_border_size 2
set $wm_setting_key_left h
set $wm_setting_key_down j
set $wm_setting_key_up k
set $wm_setting_key_right l

set $wm_setting_app_terminal alacritty
set $wm_setting_app_browser firefox
set $wm_setting_browser_private_flag "--private-window"
# set $wm_setting_app_launcher 'rofi -show drun -run-command "~/.config/i3/maintain_two_pane.py new_window {cmd}"'
set $wm_setting_app_launcher 'rofi -show drun'

set $wm_setting_app_compositor picom

set $wm_color_border_active_bg #81A1C1
set $wm_color_border_active_fg #3B4252
set $wm_color_border_inactive_bg #3B4252
set $wm_color_border_inactive_fg #D8D339
set $wm_color_background #2E3440

set $bar_setting_position bottom
set $bar_setting_mode dock
set $bar_setting_separator " - "
set $bar_setting_statusCommand i3status
set $bar_setting_trayoutput full

set $bar_color_background #3B4252
set $bar_color_foreground #D8D339
set $bar_color_statusline #D8D339
set $bar_color_separator #D8D339

set $bar_color_workspace_focused_bg #A3BE8C
set $bar_color_workspace_focused_fg #2E3440
set $bar_color_workspace_active_bg #EBCB8B
set $bar_color_workspace_active_fg #2E3440
set $bar_color_workspace_inactive_bg #BF616A
set $bar_color_workspace_urgent_bg #D08770
set $bar_color_workspace_urgent_fg #2E3440

### Applications ###
bindsym $mod+Return exec $wm_setting_app_terminal

# Start a browser
bindsym $mod+semicolon exec $wm_setting_app_browser
# Start private window 
bindsym $mod+apostrophe exec $wm_setting_app_browser $wm_setting_browser_private_flag

# Start launcher
bindsym $mod+slash exec $wm_setting_app_launcher
# bindsym $mod+w exec 'rofi -show window -window-command "~/.config/i3/maintain_two_pane.py open_window {window}"'
bindsym $mod+w exec 'rofi -show window'
bindsym $mod+period exec "firefox_url_launcher"

# Run a window compositor (for effects like transparency or full VSync)
exec_always --no-startup-id $wm_setting_app_compositor

# Start fcitx input manager
exec_always --no-startup-id "fcitx"

# Initial orientation for our two panes
default_orientation horizontal
# TODO: On startup, first create a browser and terminal

# Mark focused pane when switching focus
bindsym $mod+h exec --no-startup-id ~/.config/i3/maintain_two_pane.py focus left
bindsym $mod+l exec --no-startup-id ~/.config/i3/maintain_two_pane.py focus right

# Scratchpad shortcuts
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Rofi window switcher that handles scratchpad windows
bindsym $mod+Tab exec --no-startup-id ~/.config/i3/window_swap.sh

### Gaps ###
gaps horizontal $wm_setting_gap_width
gaps vertical $wm_setting_gap_height
smart_gaps on

### Borders ###
default_border pixel $wm_setting_border_size
default_floating_border pixel $wm_setting_border_size
smart_borders on

### Colors ###
# class			border				background			text				indicator			child_border
client.focused		$wm_color_border_active_bg	$wm_color_border_active_bg	$wm_color_border_active_fg	$wm_color_border_active_bg	$wm_color_border_active_bg
client.focused_inactive $wm_color_border_inactive_bg	$wm_color_border_inactive_bg	$wm_color_border_inactive_fg	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg
client.unfocused	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg	$wm_color_border_inactive_fg	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg
client.urgent		$wm_color_border_inactive_bg	$wm_color_border_inactive_bg	$wm_color_border_inactive_fg	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg
client.background	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg	$wm_color_border_inactive_fg	$wm_color_border_inactive_bg	$wm_color_border_inactive_bg
client.background	$wm_color_background

### polybar ###
# NOTE: This expects a launch script at the standard X user
# polybar configuration directory.
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

### miscellaneous settings
# use mouse+$mod for draggin floating windows
floating_modifier $mod

# full screen mode toggle
bindsym $mod+f fullscreen toggle

# tiling and floating toggle
bindsym $mod+$smod+f floating toggle

# Kill the focused window
bindsym $mod+q exec --no-startup-id ~/.config/i3/maintain_two_pane.py remove_window

### System ###
# Volume Bindings
bindsym XF86AudioMute exec "wpctl set-mute @DEFAULT_SINK@ toggle"
bindsym XF86AudioLowerVolume exec "wpctl set-volume @DEFAULT_SINK@ 5%-"
bindsym XF86AudioRaiseVolume exec "wpctl set-volume @DEFAULT_SINK@ 5%+"

# Screen Brightness Bindings (depends on brightnessctl)
bindsym XF86MonBrightnessUp exec "brightnessctl --class backlight set +10%"
bindsym XF86MonBrightnessDown exec "brightnessctl --class backlight set 10%-"

# Screen capture bindings
bindsym Print exec "flameshot gui"
bindsym $mod+Print exec "peek"

# Restart i3 inplace
bindsym $mod+$smod+r restart

# Exit i3 (logs out of X session)
bindsym $mod+$smod+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Temp Helper for Workspaces
bindsym $mod+u workspace number 1
bindsym $mod+i workspace number 2
bindsym $mod+o workspace number 3
bindsym $mod+p workspace number 4

exec --no-startup-id "i3-msg 'workspace 1; append_layout ~/.i3/start_tree.json'"

exec firefox --class browser
exec alacritty --class masterterm
